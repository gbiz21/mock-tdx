# Copy to .env. Never commit .env. Real values live in Bitwarden (lab) or Key Vault (Azure).

TENANT_NAME=Harbor & Main Bank
TICKET_APP_ID=431                  # TDX ticketing applications have numeric IDs; 431 is the seeded "IT Tickets" app
TIMEZONE=America/Los_Angeles

# Admin service account for POST /TDWebApi/api/auth/loginadmin (what an integration uses)
TDX_BEID=7f2c1a44-6c3e-4b7b-9a1e-2d5f8c0b1e21
TDX_WEB_SERVICES_KEY=change-me-long-random-value

# Technician password for POST /TDWebApi/api/auth (username/password login; all seeded technicians share it in the lab)
TDX_TECH_PASSWORD=ChangeMe-Lab-Only

# Token signing secret; leave empty to generate one per process start (tokens then expire on restart)
TDX_TOKEN_SECRET=
TOKEN_TTL_HOURS=24

# Optional: a URL that workflow "webhook" steps POST to (your processor or a request bin). Blank = log only.
WEBHOOK_URL=

#DB_PATH=./data/mocktdx.db
HOST=127.0.0.1
PORT=8090
